{
  "$schema_version": "1.1",
  "description": "Certificeringsstandaard Data & Analytics team. Tier classificatie: baseline = gedeelde basis voor alle Data Consultants, voldoende voor klanten op niveau 1-2 van de maturity matrix. Specialistisch = verdiepingscerts gekoppeld aan specialisatie, relevant voor klanten op niveau 3-4. Sinds v1.1: optioneel url-veld per cert (clickable naam in Beheer-UI), specialisaties komen uit de DB-tabel public.specializations.",
  "tiers": {
    "baseline": {
      "label": "Baseline",
      "description": "Gedeelde basis voor het hele team. Stelt elke Data Consultant in staat om niveau 1-2 klanten te helpen op zowel Analytics Engineering als Data Engineering vlak (T-shape principe)."
    },
    "specialist": {
      "label": "Specialistisch",
      "description": "Specialisatie-specifieke verdieping voor niveau 3-4 klantvragen. Gekoppeld aan specialisatie; niet verwacht buiten de eigen specialisatie."
    },
    "overig": {
      "label": "Overig",
      "description": "Aanvullende certificeringen die wel gestandaardiseerd worden bijgehouden, maar niet meetellen in de gap-analyse — informatief tracken van behaalde certs buiten de hoofdfocus."
    }
  },
  "relevance_levels": {
